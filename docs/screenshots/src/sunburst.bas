10 MODE 2:VDU 23,1,0;0;0;0;
20 N%=96
30 FOR I%=0 TO N%-1
40 A=2*PI*I%/N%:B=2*PI*(I%+1)/N%
50 GCOL 0,1+I% MOD 7
60 MOVE 640,512:MOVE 640+900*COS(A),512+900*SIN(A):PLOT 85,640+900*COS(B),512+900*SIN(B)
70 NEXT
80 GCOL 0,0
90 FOR I%=0 TO 64
100 A=2*PI*I%/64:B=2*PI*(I%+1)/64
110 MOVE 640,512:MOVE 640+330*COS(A),512+260*SIN(A):PLOT 85,640+330*COS(B),512+260*SIN(B)
120 NEXT
130 COLOUR 7:PRINT TAB(6,15);"AdaBeeb"
140 COLOUR 3:PRINT TAB(7,17);"MODE 2"
160 GOTO 160
