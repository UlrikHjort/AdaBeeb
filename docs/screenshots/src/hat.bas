10 MODE 1:VDU 23,1,0;0;0;0;
20 VDU 19,1,6;0;19,2,3;0;
30 COLOUR 2:PRINT TAB(2,1);"AdaBeeb - MODE 1, hidden lines"
40 DIM H%(330):FOR I%=0 TO 330:H%(I%)=0:NEXT
50 FOR Y%=-120 TO 120 STEP 8
60 GCOL 0,1+(Y% DIV 8+15) MOD 3
70 P%=FALSE
80 FOR X%=-150 TO 150 STEP 4
90 R=SQR(X%*X%+Y%*Y%)/18
100 SX%=660+X%*3.3+Y%*1.0:SY%=330+Y%*1.6+150*COS(R)*EXP(-R/7)
110 C%=SX% DIV 4:V%=SY%>H%(C%)
120 IF V% AND P% THEN DRAW SX%,SY% ELSE MOVE SX%,SY%
130 IF V% THEN H%(C%)=SY%:IF C%>0 THEN H%(C%-1)=SY%
140 P%=V%
150 NEXT
160 NEXT
170 GOTO 170
